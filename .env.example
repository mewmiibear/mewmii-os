# Copy this file to .env and fill in real values on the server. .env itself is gitignored and
# must NEVER be committed - see .gitignore. This file (.env.example) intentionally contains no
# real secrets and is safe to commit.
#
# Loaded by includes/env_loader.php, before config.php reads these. As of Security Hardening
# Phase 4D, config.php has NO hardcoded fallback for any of the values below - every one of
# them is required for the app to function. A missing .env means: no database connection at
# all, and WooCommerce sync/receipt verification cleanly reporting "not configured" instead of
# silently failing.

# Database credentials (see config/database.php)
DB_HOST=127.0.0.1
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# WooCommerce REST API credentials (WooCommerce -> Settings -> Advanced -> REST API on
# mewmiibear.com)
WC_URL=
WC_CONSUMER_KEY=
WC_CONSUMER_SECRET=

# Shared secret for the Mewmii OS <-> WordPress receipt-verification webhook - must exactly
# match the MEWMII_RECEIPT_SYNC_TOKEN constant in mewmii-preorder.php.
WC_WEBHOOK_SECRET=
