# Copy this file to .env and fill in real values on the server. .env itself is gitignored and
# must NEVER be committed - see .gitignore. This file (.env.example) intentionally contains no
# real secrets and is safe to commit.
#
# Loaded by includes/env_loader.php, before config.php reads these. As of Security Hardening
# Phase 4D, config.php has NO hardcoded fallback for any of the values below - every one of
# them is required for the app to function. A missing .env means: no database connection at
# all, and WooCommerce sync/receipt verification cleanly reporting "not configured" instead of
# silently failing.

# Database credentials (see config/database.php)
DB_HOST=127.0.0.1
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# WooCommerce REST API credentials (WooCommerce -> Settings -> Advanced -> REST API on
# mewmiibear.com)
WC_URL=
WC_CONSUMER_KEY=
WC_CONSUMER_SECRET=

# Shared secret for the Mewmii OS <-> WordPress receipt-verification webhook - must exactly
# match the MEWMII_RECEIPT_SYNC_TOKEN constant in mewmii-preorder.php.
WC_WEBHOOK_SECRET=

# Separate, independent secret for INBOUND WooCommerce webhook deliveries (modules/webhooks/
# woocommerce.php) - do NOT reuse WC_WEBHOOK_SECRET above, a different trust direction. Must
# match the Secret configured on each webhook in WooCommerce (Settings -> Advanced -> Webhooks).
# Register one webhook per topic needed, all pointing at the same receiver URL:
#   product.created, product.updated, product.deleted
#   order.created, order.updated, order.deleted
#   customer.created, customer.updated, customer.deleted
# The *.deleted topics archive/cancel the matching Mewmii OS record - they never delete
# anything (see includes/wc_webhook.php's wc_webhook_dispatch_product_deleted()/
# wc_webhook_dispatch_order_deleted()/wc_webhook_dispatch_customer_deleted()).
WC_WEBHOOK_RECEIVE_SECRET=
